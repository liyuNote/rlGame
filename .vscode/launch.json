{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "PPO Train",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "D:/app/anaconda/envs/rlgame-ppo/python.exe",
            "args": [
                "--mode",
                "train",
                "--max-train-steps",
                "400",
                "--batch-size",
                "64",
                "--mini-batch-size",
                "32",
                "--max-episode-steps",
                "64"
            ]
        },
        {
            "name": "PPO Test",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "D:/app/anaconda/envs/rlgame-ppo/python.exe",
            "args": [
                "--mode",
                "test",
                "--max-episode-steps",
                "64",
                "--no-plot"
            ]
        },
        {
            "name": "PPO Test With Animation",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "D:/app/anaconda/envs/rlgame-ppo/python.exe",
            "args": [
                "--mode",
                "test",
                "--max-episode-steps",
                "64",
                "--animation-output",
                "outputs/satellite_game.gif",
                "--animation-fps",
                "8"
            ]
        }
    ]
}
